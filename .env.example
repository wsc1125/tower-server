# 本地开发环境变量。复制为 .env 后按需修改。
# .env 不入库（见 .gitignore），避免密钥进版本库。

APP_ENV=development
HTTP_ADDR=:8080

# 与 docker-compose.yml 的 postgres 服务一致。
DATABASE_URL=postgres://tower:devpassword@localhost:5432/tower?sslmode=disable

# 本地开发用的弱密钥。生产环境必须换成 32 字节以上随机值。
JWT_SECRET=dev-jwt-secret-change-me-at-least-32-bytes

ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12

# ---- 中继（coturn）----
# 必须与 docker-compose.yml 里 coturn 的 --static-auth-secret 一致。
# 生产环境必须换成 32 字节以上随机值。
TURN_SHARED_SECRET=dev-turn-shared-secret-change-me
TURN_REALM=tower.local

# coturn 对外可达的地址。本地开发用 127.0.0.1（只能本机测试）；
# 上云后填公网域名或 IP，否则客户端连不上中继。
TURN_HOST=127.0.0.1
TURN_PORT=3478

# 临时凭证有效期。
TURN_TTL=24h

# ---- 头像 ----
# 头像文件存储目录（相对服务端工作目录）。
AVATAR_DIR=data/avatars

# 服务端对外可达的基地址，用于拼接头像 URL。
# 上云后必须改成公网域名，否则客户端拿到的头像地址指向 localhost。
PUBLIC_BASE_URL=http://localhost:8080
